PORT=3001
NODE_ENV=development
API_KEY=your-api-key-here
ALLOWED_ORIGINS=http://localhost:3002
API_BASE_URL=http://localhost:3001
# Comma-separated allowlist of admin Google account emails (case-insensitive).
ADMIN_EMAILS=you@example.com
# GCP/Firebase project id for verifying Firebase ID tokens (falls back to GOOGLE_CLOUD_PROJECT; ADC supplies it on Cloud Run).
FIREBASE_PROJECT_ID=your-gcp-project-id
