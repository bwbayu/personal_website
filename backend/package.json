{
  "name": "backend",
  "version": "0.0.0",
  "private": true,
  "scripts": {
    "start": "node ./dist/bin/www",
    "dev": "ts-node ./bin/www",
    "build": "tsc",
    "test": "vitest run",
    "test:emulator": "firebase emulators:exec --only firestore --project demo-test \"vitest run --config vitest.emulator.config.ts\"",
    "test:all": "npm test && npm run test:emulator",
    "migrate": "ts-node src/config/migration.ts",
    "patch:media-socials": "ts-node src/config/patch-media-socials.ts",
    "patch:data-model-cleanup": "ts-node src/config/patch-data-model-cleanup.ts",
    "patch:projects-visible": "ts-node src/config/patch-projects-visible.ts"
  },
  "dependencies": {
    "@google-cloud/firestore": "^7.5.0",
    "cors": "^2.8.6",
    "debug": "~2.6.9",
    "dotenv": "^17.4.2",
    "express": "^4.22.1",
    "express-rate-limit": "^8.3.1",
    "firebase-admin": "^14.0.0",
    "helmet": "^8.1.0",
    "morgan": "^1.10.1",
    "swagger-ui-express": "^5.0.1",
    "zod": "^4.3.6"
  },
  "devDependencies": {
    "@types/cors": "^2.8.19",
    "@types/debug": "^4.1.13",
    "@types/express": "^4.17.21",
    "@types/morgan": "^1.9.10",
    "@types/node": "^25.5.0",
    "@types/supertest": "7.2.0",
    "@types/swagger-ui-express": "^4.1.8",
    "firebase-tools": "15.22.0",
    "supertest": "7.2.2",
    "ts-node": "^10.9.2",
    "typescript": "^5.9.3",
    "vitest": "4.1.9"
  }
}
